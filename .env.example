# =====================================================================
# NotesGPT Environment Configuration
# =====================================================================
# NotesGPT can run in two primary modes:
# 1. LOCAL / GUEST MODE (100% Offline & Private):
#    - No cloud API keys or Firebase setup needed.
#    - Uses browser IndexedDB, PDF.js, Tesseract OCR, and Local AI (Ollama/WebLLM).
#
# 2. CLOUD MODE:
#    - Requires Google Gemini API Key and Firebase Project Credentials.
#    - Delivers ultra-fast server RAG indexing, Firestore vector storage,
#      and Gemini 1.5 Flash generation for large documents.
# =====================================================================

# --- Google Gemini AI (Required for Cloud RAG & Generation) ---
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional alias recognized by the Google AI SDK:
# GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# --- Firebase Client Configuration (Required for Cloud Mode) ---
# Obtain from Firebase Console -> Project Settings -> General -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:your_app_id

# --- Optional: Local Ollama URL (defaults to http://localhost:11434) ---
# OLLAMA_BASE_URL=http://localhost:11434
